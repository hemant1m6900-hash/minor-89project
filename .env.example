# SQLite database connection string (SQLAlchemy)
DATABASE_URL=sqlite:///./ecommerce_intelligence.db

# JWT signing secret (change in production / local .env)
APP_SECRET_KEY=change-this-local-development-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local file preservation directory for uploaded CSVs
UPLOAD_DIR=storage/uploads

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
